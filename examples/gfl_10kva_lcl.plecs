      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/gfl_current_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Disabled: the algorithm is not run */\nif (!(InputSignal(0, 0) > 0.0)) {\n    for (int k = 0; k < 4; k++) {\n        OutputSignal(0, k) = 0.0;\n    }\n    for (int k = 0; k < 4; k++) {\n        OutputSignal(1, k) = 0.0;\n    }\n    for (int k = 0; k < 3; k++) {\n        OutputSignal(2, k) = 0.0;\n    }\n    return;\n}\n\ndouble fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(1, k);\n}\nGFLFeedbacks fbk;\ngfl_feedbacks_unpack(fbk_u, &fbk);\ndouble ref_u[REF_WIDTH];\nfor (int k = 0; k < REF_WIDTH; k++) {\n    ref_u[k] = InputSignal(2, k);\n}\nGFLReferences ref;\ngfl_references_unpack(ref_u, &ref);\n/* Monitored signals */\nOutputSignal(0, 0) = ref.p_g;\nOutputSignal(0, 1) = fbk.p_g;\nOutputSignal(0, 2) = ref.q_g;\nOutputSignal(0, 3) = fbk.q_g;\nOutputSignal(1, 0) = creal(ref.i_c);\nOutputSignal(1, 1) = creal(fbk.i_c);\nOutputSignal(1, 2) = cimag(ref.i_c);\nOutputSignal(1, 3) = cimag(fbk.i_c);\nOutputSignal(2, 0) = fbk.u_g;\nOutputSignal(2, 1) = fbk.w_g;\nOutputSignal(2, 2) = fbk.theta_c;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
