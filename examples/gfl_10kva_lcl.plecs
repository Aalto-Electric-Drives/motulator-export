        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "u_th"
        Prompt        "u_th: Threshold voltage (V) in InverterNonlinearity (d_err = None if t_d = u_th = 0)"
        Type          FreeText
        Value         "pwm.u_th"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
