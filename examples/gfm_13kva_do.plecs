        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_plecs.grid. The control algorithms are in the\n * included C files. The parameters come from the mask of the subsystem. */\n#include \"../motulator_plecs/c/common.c\"\n#include \"../motulator_plecs/c/gfm_observer.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n/* Check that a GradNet in the parameters i0, i0 + 1, ... (GRADNET_FIELDS) fits\n * in the arrays of the C port (in the start function only, returns on error) */\n#define CHECK_GRADNET(i0) \\\n    do { \\\n        if ((int)P((i0), 0) > GRADNET_MAX_IN_DIM \\\n            || PDIM((i0) + 3) > GRADNET_MAX_EMBED_DIM) { \\\n            SetErrorMessage(\"GradNet too large: in_dim must be at most \" \\\n                            \"4 and embed_dim at most \" \\\n                            \"64.\"); \\\n            return; \\\n        } \\\n    } while (0)\n\n/* Read a GradNet from the parameters i0, i0 + 1, ... (GRADNET_FIELDS) */\n#define READ_GRADNET(net, i0) \\\n    do { \\\n        (net).in_dim = (int)P((i0), 0); \\\n        (net).mu_dim = (int)P((i0) + 1, 0); \\\n        (net).embed_dim = PDIM((i0) + 3); \\\n        for (int j_ = 0; j_ < (net).embed_dim; j_++) { \\\n            for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n                (net).W[j_][k_] = P((i0) + 2, j_ + (net).embed_dim * k_); \\\n            } \\\n            (net).b[j_] = P((i0) + 3, j_); \\\n        } \\\n        for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n            (net).mu_log[k_] = (k_ < (net).mu_dim) ? P((i0) + 4, k_) : 0.0; \\\n            (net).bias[k_] = P((i0) + 5, k_); \\\n        } \\\n        (net).activation = (GradNetActivation)(int)P((i0) + 6, 0); \\\n        (net).beta_log = P((i0) + 7, 0); \\\n        (net).p = (int)P((i0) + 8, 0); \\\n        (net).in_base = P((i0) + 9, 0); \\\n        (net).out_base = P((i0) + 10, 0); \\\n    } while (0)\n\nstatic GFMControlSystem ctrl;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "/* Check the parameters of the mask */\nif (PDIM(0) != 1) {\n    SetErrorMessage(\"i_max must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"L must be a scalar.\");\n    return;\n}\nif (PDIM(9) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\n\n/* Configuration (ObserverBasedGridFormingControllerCfg), the defaults are\n * used for empty parameters */\nGFMControllerCfg cfg = gfm_controller_cfg(P(0, 0), P(1, 0));\nif (PDIM(2) > 0) {\n    cfg.R = P(2, 0);\n}\nif (PDIM(3) > 0) {\n    cfg.R_a = P(3, 0);\n}\nif (PDIM(4) > 0) {\n    cfg.k_v = P(4, 0);\n}\nif (PDIM(5) > 0) {\n    cfg.alpha_o = P(5, 0);\n}\nif (PDIM(6) > 0) {\n    cfg.alpha_c = P(6, 0);\n}\nif (PDIM(7) > 0) {\n    cfg.u_nom = P(7, 0);\n}\nif (PDIM(8) > 0) {\n    cfg.w_nom = P(8, 0);\n}\nif (PDIM(9) > 0) {\n    cfg.T_s = P(9, 0);\n}\nif (PDIM(10) > 0) {\n    cfg.i_d_max = P(10, 0);\n}\nif (PDIM(11) > 0) {\n    cfg.alpha_l = P(11, 0);\n}\ngfm_control_system_init(&ctrl, &cfg);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Measurements and references */\ndouble i_c_abc[3] = {InputSignal(2, 0), InputSignal(2, 1),\n                     InputSignal(2, 2)};\nGFMMeasurements meas = {abc2complex(i_c_abc), InputSignal(3, 0)};\ngfm_control_system_compute_output(&ctrl, &meas, InputSignal(0, 0),\n                                  InputSignal(1, 0));\n\n/* Duty ratios, delayed by the Delay block outside the subsystem */\nfor (int k = 0; k < 3; k++) {\n    OutputSignal(0, k) = ctrl.ref.d_abc[k];\n}\n\n/* Monitored signals */\nOutputSignal(1, 0) = ctrl.ref.p_g;\nOutputSignal(1, 1) = ctrl.fbk.p_g;\nOutputSignal(1, 2) = ctrl.fbk.q_g;\nOutputSignal(2, 0) = ctrl.ref.v_c;\nOutputSignal(2, 1) = cabs(ctrl.fbk.v_c);\nOutputSignal(3, 0) = creal(ctrl.ref.i_c);\nOutputSignal(3, 1) = creal(ctrl.fbk.i_c);\nOutputSignal(3, 2) = cimag(ctrl.ref.i_c);\nOutputSignal(3, 3) = cimag(ctrl.fbk.i_c);\nOutputSignal(4, 0) = ctrl.fbk.theta_c;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "gfm_control_system_update(&ctrl);\n"
        Show          off
      }
