Plecs {
  Name          "gfm_13kva_do"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1.4"
  Solver        "dopri"
  MaxStep       "cfg.T_s"
  InitStep      "-1"
  RelTol        "1e-6"
  AbsTol        "-1"
  InitializationCommands "% Generated from motulator. The blocks of the control system have masks of the\n% arguments of their classes, which refer to the structs below, as in the\n% motulator API.\n\n%% System model\nconverter.u_dc = 650;\nac_filter.L_f = 0.006125876615797688;\nac_filter.R_f = 0.6415002990995841;\nac_filter.L_g = 0.030220991304601926;\nac_source.e_g = 326.5986323710904;\nac_source.w_g = 2*pi*50;\n\n%% Control system ([] = None, the default)\n% Grid-forming control (ObserverBasedGridFormingControllerCfg)\ncfg.i_max = 33.09259735953043;\ncfg.L = 0.014293712103527936;\ncfg.R = 0.6415002990995841;\ncfg.R_a = 2.5660011963983362;\ncfg.k_v = [];\ncfg.alpha_o = 2*pi*50;\ncfg.alpha_c = 2*pi*400;\ncfg.u_nom = 326.5986323710904;\ncfg.w_nom = 2*pi*50;\ncfg.i_d_max = [];\ncfg.alpha_l = 2*pi*50;\ncfg.T_s = 0.000125;\n% PWM: the duty-ratio error model d_err = dead_time_error(i_abc, d_abc,\n% t_d, cfg.T_s, sign) with sign = tanh(i/i_0) (np.sign if i_0 = 0), its\n% compensation, the minimum duty ratio of a switching leg, and the\n% overmodulation ('MPE' or 'MME')\npwm.t_d = 0;\npwm.i_0 = 0;\npwm.feedforward = 1;\npwm.d_min = 0;\npwm.overmodulation = 'MPE';\n"
