        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
        Variable      "J"
        Prompt        base64 "SjogSW5lcnRpYSAoa2dtwrIpIGZvciB0aGUgc3BlZWQgb2JzZXJ2ZXIsIFtdID0gbm90IHVzZWQ="
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
