        Prompt        base64 "SjogVG90YWwgaW5lcnRpYSAoa2dtwrIp"
        Type          FreeText
        Value         "0.015"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "speed_alpha_s"
        Prompt        "alpha_s: Reference-tracking bandwidth (rad/s)"
        Type          FreeText
        Value         "2*pi*4"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "speed_alpha_i"
        Prompt        "alpha_i: Integral-action bandwidth (rad/s), [] = alpha_s"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "speed_tau_M_max"
        Prompt        "tau_M_max: Maximum motor torque (Nm)"
        Type          FreeText
        Value         "inf"
        Show          off
        Tunable       on
        TabName       "Speed control (SpeedController)"
      }
      Parameter {
        Variable      "pwm_t_d"
        Prompt        "t_d: Dead time (s) in d_err = dead_time_error(i_abc, d_abc, t_d, T_s), 0 = None"
        Type          FreeText
        Value         "0.0"
        Show          off
        Tunable       on
        TabName       "PWM (PWM)"
      }
      Parameter {
        Variable      "pwm_i_0"
        Prompt        "i_0: Current scale (A) of sign = tanh(i/i_0) in dead_time_error, 0 = np.sign"
        Type          FreeText
        Value         "0.0"
        Show          off
        Tunable       on
        TabName       "PWM (PWM)"
      }
      Parameter {
        Variable      "pwm_feedforward"
        Prompt        "feedforward: Compensate for d_err (1) or not (0)"
        Type          FreeText
        Value         "1.0"
        Show          off
        Tunable       on
        TabName       "PWM (PWM)"
      }
      Parameter {
        Variable      "pwm_d_min"
        Prompt        "d_min: Minimum duty ratio of a switching leg, 0 = no limit"
        Type          FreeText
