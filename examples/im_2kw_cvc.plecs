        Prompt        "sensorless: Sensorless mode (1) or sensored mode (0)"
        Type          FreeText
        Value         "1.0"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
        Variable      "T_s"
