    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [200, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -60; 50, 60]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
