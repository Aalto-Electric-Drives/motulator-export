    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [200, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -60; 50, 60]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[1 1 3 1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[3 2 2 2 4]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "n_p, R_s, R_R, L_sgm, L_M, psi_s_nom, i_s_max, alpha_c, alpha_i, alpha_o, w_s_nom, k_u, k_fw, J, sensorless, T_s, speed_J, speed_alpha_s, speed_alpha_i, speed_tau_M_max, pwm_t_d, pwm_i_0, pwm_feedforward, pwm_d_min"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export.plecs.im. The control algorithms are in the\n * included C files. The parameters come from the mask of the subsystem. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/im_current_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n/* Lower limit (V) of the measured DC-bus voltage, which avoids the division by\n * zero in the PWM if the DC bus is not charged */\n#define U_DC_MIN 1.0\n\nstatic IMVectorControlSystem ctrl;\n\n/* Initial state, restored while the control system is disabled */\nstatic IMVectorControlSystem ctrl_init;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "/* Check the parameters of the mask */\nif (PDIM(0) != 1) {\n    SetErrorMessage(\"n_p must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"R_s must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 1) {\n    SetErrorMessage(\"R_R must be a scalar.\");\n    return;\n}\nif (PDIM(3) != 1) {\n    SetErrorMessage(\"L_sgm must be a scalar.\");\n    return;\n}\nif (PDIM(4) != 1) {\n    SetErrorMessage(\"L_M must be a scalar.\");\n    return;\n}\nif (PDIM(5) != 1) {\n    SetErrorMessage(\"psi_s_nom must be a scalar.\");\n    return;\n}\nif (PDIM(6) != 1) {\n    SetErrorMessage(\"i_s_max must be a scalar.\");\n    return;\n}\nif (PDIM(15) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nif (PDIM(16) != 1) {\n    SetErrorMessage(\"speed_J must be a scalar.\");\n    return;\n}\nif (PDIM(17) != 1) {\n    SetErrorMessage(\"speed_alpha_s must be a scalar.\");\n    return;\n}\nif (PDIM(20) != 1) {\n    SetErrorMessage(\"pwm_t_d must be a scalar.\");\n    return;\n}\nif (PDIM(21) != 1) {\n    SetErrorMessage(\"pwm_i_0 must be a scalar.\");\n    return;\n}\nif (PDIM(22) != 1) {\n    SetErrorMessage(\"pwm_feedforward must be a scalar.\");\n    return;\n}\nif (PDIM(23) != 1) {\n    SetErrorMessage(\"pwm_d_min must be a scalar.\");\n    return;\n}\n\n/* Machine model parameters (InductionMachineInvGammaPars) */\nInductionMachineInvGammaPars par = {\n    P(0, 0), P(1, 0), P(2, 0), P(3, 0), P(4, 0)};\n\n/* Current-vector controller configuration (CurrentVectorControllerCfg),\n * the defaults are used for empty parameters */\nIMCurrentVectorControllerCfg cfg = im_current_vector_controller_cfg(\n    P(5, 0), P(6, 0));\nif (PDIM(7) > 0) {\n    cfg.alpha_c = P(7, 0);\n}\nif (PDIM(8) > 0) {\n    cfg.alpha_i = P(8, 0);\n}\nif (PDIM(9) > 0) {\n    cfg.alpha_o = P(9, 0);\n}\nif (PDIM(10) > 0) {\n    cfg.w_s_nom = P(10, 0);\n}\nif (PDIM(11) > 0) {\n    cfg.k_u = P(11, 0);\n}\nif (PDIM(12) > 0) {\n    cfg.k_fw = P(12, 0);\n}\nif (PDIM(13) > 0) {\n    cfg.J = P(13, 0);\n}\nif (PDIM(14) > 0) {\n    cfg.sensorless = P(14, 0);\n}\nif (PDIM(15) > 0) {\n    cfg.T_s = P(15, 0);\n}\n\n/* Speed controller (SpeedController) */\nPIController speed_ctrl = speed_controller(\n    P(16, 0), P(17, 0), PARAM(18),\n    PDIM(19) > 0 ? P(19, 0) : INFINITY);\n\nim_vector_control_system_init(&ctrl, par, &cfg, speed_ctrl);\n\n/* Duty-ratio error model of the PWM (dead_time_error) */\npwm_set_dead_time(&ctrl.pwm, P(20, 0), P(15, 0),\n                  P(21, 0), (int)P(22, 0));\n/* Minimum duty ratio of a switching leg */\npwm_set_min_pulse(&ctrl.pwm, P(23, 0));\n\nctrl_init = ctrl;\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Disabled: zero voltage, the control algorithm is not run */\nif (!(InputSignal(0, 0) > 0.0)) {\n    for (int k = 0; k < 3; k++) {\n        OutputSignal(0, k) = 0.5;\n    }\n    OutputSignal(1, 0) = 0.0;\n    OutputSignal(1, 1) = 0.0;\n    OutputSignal(2, 0) = 0.0;\n    OutputSignal(2, 1) = 0.0;\n    OutputSignal(3, 0) = 0.0;\n    OutputSignal(3, 1) = 0.0;\n    OutputSignal(4, 0) = 0.0;\n    OutputSignal(4, 1) = 0.0;\n    OutputSignal(4, 2) = 0.0;\n    OutputSignal(4, 3) = 0.0;\n    return;\n}\n\n/* Measurements */\ndouble w_M_ref = InputSignal(1, 0);\ndouble i_s_abc[3] = {InputSignal(2, 0), InputSignal(2, 1),\n                     InputSignal(2, 2)};\ndouble u_dc = fmax(InputSignal(3, 0), U_DC_MIN);\nIMMeasurements meas = {abc2complex(i_s_abc), u_dc, InputSignal(4, 0)};\n\nim_vector_control_system_compute_output(&ctrl, &meas, w_M_ref);\n\n/* Duty ratios, delayed by the Delay block outside the subsystem */\nfor (int k = 0; k < 3; k++) {\n    OutputSignal(0, k) = ctrl.ref.d_abc[k];\n}\n\n/* Monitored signals, the currents in estimated rotor flux coordinates */\ndouble complex rot = cexp(-I * carg(ctrl.fbk.psi_R));\nOutputSignal(1, 0) = ctrl.ref.w_M;\nOutputSignal(1, 1) = ctrl.fbk.w_M;\nOutputSignal(2, 0) = ctrl.ref.tau_M;\nOutputSignal(2, 1) = ctrl.fbk.tau_M;\nOutputSignal(3, 0) = cabs(ctrl.fbk.psi_s);\nOutputSignal(3, 1) = cabs(ctrl.fbk.psi_R);\nOutputSignal(4, 0) = creal(rot * ctrl.ref.i_s);\nOutputSignal(4, 1) = creal(rot * ctrl.fbk.i_s);\nOutputSignal(4, 2) = cimag(rot * ctrl.ref.i_s);\nOutputSignal(4, 3) = cimag(rot * ctrl.fbk.i_s);\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "/* Disabled: reset the state */\nif (!(InputSignal(0, 0) > 0.0)) {\n    ctrl = ctrl_init;\n    return;\n}\n\nim_vector_control_system_update(&ctrl);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
    Component {
