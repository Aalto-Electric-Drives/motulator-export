      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Value"
        Value         "1.0"
        Show          off
      }
    }
    Component {
      Type          Step
      Name          "w_M_ref"
      Show          on
      Position      [60, 60]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Time"
        Value         "0.2000625"
        Show          off
      }
      Parameter {
        Variable      "Before"
        Value         "0.0"
        Show          off
      }
      Parameter {
        Variable      "After"
        Value         "78.53981633974483"
        Show          off
      }
      Parameter {
        Variable      "DataType"
        Value         "10"
        Show          off
      }
    }
    Component {
      Type          PlecsProbe
      Name          "i_s_abc"
      Show          on
      Position      [60, 100]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "Machine"
        Path          ""
        Signals       {"Stator phase currents"}
      }
    }
    Component {
      Type          PlecsProbe
      Name          "u_dc meas."
      Show          on
      Position      [60, 140]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "u_dc"
        Path          ""
        Signals       {"Measured voltage"}
      }
    }
    Component {
      Type          PlecsProbe
      Name          "w_M"
      Show          on
      Position      [60, 180]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "Machine"
        Path          ""
        Signals       {"Rotational speed"}
      }
    }
    Component {
      Type          Subsystem
      Name          "Current-vector control"
      Show          on
      Position      [250, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Current-vector control (motulator)"
      MaskDescription "Speed control of an induction machine drive with current-vector control. The parameters correspond to the motulator API: InductionMachineInvGammaPars, CurrentVectorControllerCfg, and SpeedController. Empty parameters ([]) correspond to None, i.e., the defaults of motulator. While the input enable is not positive, the duty ratios are 0.5 and the state is reset to its initial value."
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "n_p"
        Prompt        "n_p: Number of pole pairs"
        Type          FreeText
        Value         "2.0"
        Show          off
        Tunable       on
        TabName       "Machine model (InductionMachineInvGammaPars)"
      }
      Parameter {
        Variable      "R_s"
        Prompt        base64 "Ul9zOiBTdGF0b3IgcmVzaXN0YW5jZSAozqkp"
        Type          FreeText
        Value         "3.7"
        Show          off
        Tunable       on
        TabName       "Machine model (InductionMachineInvGammaPars)"
      }
      Parameter {
        Variable      "R_R"
        Prompt        base64 "Ul9SOiBSb3RvciByZXNpc3RhbmNlICjOqSk="
        Type          FreeText
        Value         "2.1"
        Show          off
        Tunable       on
        TabName       "Machine model (InductionMachineInvGammaPars)"
      }
      Parameter {
        Variable      "L_sgm"
        Prompt        "L_sgm: Leakage inductance (H)"
        Type          FreeText
        Value         "0.021"
        Show          off
        Tunable       on
        TabName       "Machine model (InductionMachineInvGammaPars)"
      }
      Parameter {
        Variable      "L_M"
        Prompt        "L_M: Magnetizing inductance (H)"
        Type          FreeText
        Value         "0.224"
        Show          off
        Tunable       on
        TabName       "Machine model (InductionMachineInvGammaPars)"
      }
      Parameter {
        Variable      "psi_s_nom"
        Prompt        "psi_s_nom: Nominal stator flux linkage (Vs)"
        Type          FreeText
        Value         "1.0395957349782348"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
        Variable      "i_s_max"
        Prompt        "i_s_max: Maximum stator current (A)"
        Type          FreeText
        Value         "10.606601717798213"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_c"
        Prompt        "alpha_c: Current-control bandwidth (rad/s)"
        Type          FreeText
        Value         "2*pi*200"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_i"
        Prompt        "alpha_i: Integral-action bandwidth (rad/s), [] = alpha_c"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Current-vector control (CurrentVectorControllerCfg)"
      }
      Parameter {
