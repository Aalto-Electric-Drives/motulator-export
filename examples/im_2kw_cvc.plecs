        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "n_p, R_s, R_R, L_sgm, L_M, psi_s_nom, i_s_max, alpha_c, alpha_i, alpha_o, w_s_nom, k_u, k_fw, J, sensorless, T_s, speed_J, speed_alpha_s, speed_alpha_i, speed_tau_M_max"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_plecs.im. The control algorithms are in the\n * included C files. The parameters come from the mask of the subsystem. */\n#include \"../motulator_plecs/c/common.c\"\n#include \"../motulator_plecs/c/im_current_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n/* Check that a GradNet in the parameters i0, i0 + 1, ... (GRADNET_FIELDS) fits\n * in the arrays of the C port (in the start function only, returns on error) */\n#define CHECK_GRADNET(i0) \\\n    do { \\\n        if ((int)P((i0), 0) > GRADNET_MAX_IN_DIM \\\n            || PDIM((i0) + 3) > GRADNET_MAX_EMBED_DIM) { \\\n            SetErrorMessage(\"GradNet too large: in_dim must be at most \" \\\n                            \"4 and embed_dim at most \" \\\n                            \"64.\"); \\\n            return; \\\n        } \\\n    } while (0)\n\n/* Read a GradNet from the parameters i0, i0 + 1, ... (GRADNET_FIELDS) */\n#define READ_GRADNET(net, i0) \\\n    do { \\\n        (net).in_dim = (int)P((i0), 0); \\\n        (net).mu_dim = (int)P((i0) + 1, 0); \\\n        (net).embed_dim = PDIM((i0) + 3); \\\n        for (int j_ = 0; j_ < (net).embed_dim; j_++) { \\\n            for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n                (net).W[j_][k_] = P((i0) + 2, j_ + (net).embed_dim * k_); \\\n            } \\\n            (net).b[j_] = P((i0) + 3, j_); \\\n        } \\\n        for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n            (net).mu_log[k_] = (k_ < (net).mu_dim) ? P((i0) + 4, k_) : 0.0; \\\n            (net).bias[k_] = P((i0) + 5, k_); \\\n        } \\\n        (net).activation = (GradNetActivation)(int)P((i0) + 6, 0); \\\n        (net).beta_log = P((i0) + 7, 0); \\\n        (net).p = (int)P((i0) + 8, 0); \\\n        (net).in_base = P((i0) + 9, 0); \\\n        (net).out_base = P((i0) + 10, 0); \\\n    } while (0)\n\nstatic IMVectorControlSystem ctrl;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "/* Check the parameters of the mask */\nif (PDIM(0) != 1) {\n    SetErrorMessage(\"n_p must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"R_s must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 1) {\n    SetErrorMessage(\"R_R must be a scalar.\");\n    return;\n}\nif (PDIM(3) != 1) {\n    SetErrorMessage(\"L_sgm must be a scalar.\");\n    return;\n}\nif (PDIM(4) != 1) {\n    SetErrorMessage(\"L_M must be a scalar.\");\n    return;\n}\nif (PDIM(5) != 1) {\n    SetErrorMessage(\"psi_s_nom must be a scalar.\");\n    return;\n}\nif (PDIM(6) != 1) {\n    SetErrorMessage(\"i_s_max must be a scalar.\");\n    return;\n}\nif (PDIM(15) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nif (PDIM(16) != 1) {\n    SetErrorMessage(\"speed_J must be a scalar.\");\n    return;\n}\nif (PDIM(17) != 1) {\n    SetErrorMessage(\"speed_alpha_s must be a scalar.\");\n    return;\n}\n\n/* Machine model parameters (InductionMachineInvGammaPars) */\nInductionMachineInvGammaPars par = {\n    P(0, 0), P(1, 0), P(2, 0), P(3, 0), P(4, 0)};\n\n/* Current-vector controller configuration (CurrentVectorControllerCfg),\n * the defaults are used for empty parameters */\nIMCurrentVectorControllerCfg cfg = im_current_vector_controller_cfg(\n    P(5, 0), P(6, 0));\nif (PDIM(7) > 0) {\n    cfg.alpha_c = P(7, 0);\n}\nif (PDIM(8) > 0) {\n    cfg.alpha_i = P(8, 0);\n}\nif (PDIM(9) > 0) {\n    cfg.alpha_o = P(9, 0);\n}\nif (PDIM(10) > 0) {\n    cfg.w_s_nom = P(10, 0);\n}\nif (PDIM(11) > 0) {\n    cfg.k_u = P(11, 0);\n}\nif (PDIM(12) > 0) {\n    cfg.k_fw = P(12, 0);\n}\nif (PDIM(13) > 0) {\n    cfg.J = P(13, 0);\n}\nif (PDIM(14) > 0) {\n    cfg.sensorless = P(14, 0);\n}\nif (PDIM(15) > 0) {\n    cfg.T_s = P(15, 0);\n}\n\n/* Speed controller (SpeedController) */\nPIController speed_ctrl = speed_controller(\n    P(16, 0), P(17, 0), PARAM(18),\n    PDIM(19) > 0 ? P(19, 0) : INFINITY);\n\nim_vector_control_system_init(&ctrl, par, &cfg, speed_ctrl);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Measurements */\ndouble w_M_ref = InputSignal(0, 0);\ndouble i_s_abc[3] = {InputSignal(1, 0), InputSignal(1, 1),\n                     InputSignal(1, 2)};\nIMMeasurements meas = {abc2complex(i_s_abc), InputSignal(2, 0),\n                       InputSignal(3, 0)};\n\nim_vector_control_system_compute_output(&ctrl, &meas, w_M_ref);\n\n/* Duty ratios, delayed by the Delay block outside the subsystem */\nfor (int k = 0; k < 3; k++) {\n    OutputSignal(0, k) = ctrl.ref.d_abc[k];\n}\n\n/* Monitored signals, the currents in estimated rotor flux coordinates */\ndouble complex rot = cexp(-I * carg(ctrl.fbk.psi_R));\nOutputSignal(1, 0) = ctrl.ref.w_M;\nOutputSignal(1, 1) = ctrl.fbk.w_M;\nOutputSignal(2, 0) = ctrl.ref.tau_M;\nOutputSignal(2, 1) = ctrl.fbk.tau_M;\nOutputSignal(3, 0) = cabs(ctrl.fbk.psi_s);\nOutputSignal(3, 1) = cabs(ctrl.fbk.psi_R);\nOutputSignal(4, 0) = creal(rot * ctrl.ref.i_s);\nOutputSignal(4, 1) = creal(rot * ctrl.fbk.i_s);\nOutputSignal(4, 2) = cimag(rot * ctrl.ref.i_s);\nOutputSignal(4, 3) = cimag(rot * ctrl.fbk.i_s);\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "im_vector_control_system_update(&ctrl);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
