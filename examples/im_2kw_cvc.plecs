  Solver        "dopri"
  MaxStep       "0.000125"
  InitStep      "-1"
  RelTol        "1e-6"
  AbsTol        "-1"
  InitializationCommands "% Generated from motulator. The parameters of the control system are in\n% the mask of the subsystem 'Current-vector control'.\nmachine.n_p = 2.0;\nmachine.R_s = 3.7;\nmachine.R_R = 2.1;\nmachine.L_sgm = 0.021;\nmachine.L_M = 0.224;\nmechanics.J = 0.015;\nconverter.u_dc = 540.0;\n"
  Schematic {
    Location      [0, 0; 880, 480]
    ZoomFactor    1
    SliderPosition [0, 0]
    ShowBrowser   off
    BrowserWidth  100
