    Component {
      Type          Subsystem
      Name          "SpeedFluxObserver"
      Show          on
      Position      [420, 220]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -40; 50, 40]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "SpeedFluxObserver (motulator)"
      MaskDescription "Flux observer with speed estimation, created by create_speed_flux_observer with the default observer gain k_o. The mask initialization resolves the defaults of create_speed_flux_observer and computes the gains of the SpeedObserver and the FluxObserver inside it, as in SpeedFluxObserver. The machine model par is a struct with the fields n_p, R_s, R_R, L_sgm, and L_M of InductionMachineInvGammaPars."
      MaskInit      "% Default speed estimation poles of create_speed_flux_observer. With J, the\n% double pole at alpha_o/2 keeps the speed gain about the same.\nalpha_o_obs = alpha_o;\nif isempty(alpha_o_obs)\n  if sensorless\n    alpha_o_obs = 2*pi*60;\n  else\n    alpha_o_obs = 2*pi*400;\n  end\n  if ~isempty(J)\n    alpha_o_obs = 0.5*alpha_o_obs;\n  end\nend\n% Gains for critically damped dynamics (SpeedFluxObserver.__init__), the\n% pole matched to the sampling period (matched_pole)\nalpha_o_obs = -expm1(-alpha_o_obs*T_s)/T_s;\nif isempty(J)\n  k_w = alpha_o_obs;\n  k_tau = 0;\nelse\n  k_w = 2*alpha_o_obs;\n  k_tau = J*alpha_o_obs^2;\nend\n% Default observer gain of create_speed_flux_observer, and the weight of the\n% measured rotor speed in the FluxObserver\nk_o = sensorless;\nh = 1 - sensorless;\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "par"
        Prompt        "par: Machine model (InductionMachineInvGammaPars) as a struct"
        Type          FreeText
        Value         "par"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "alpha_o"
        Prompt        "alpha_o: Speed estimation poles (rad/s), [] = default"
        Type          FreeText
        Value         "cfg.alpha_o"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "sensorless"
        Prompt        "sensorless: Sensorless mode (1) or sensored mode (0)"
        Type          FreeText
        Value         "cfg.sensorless"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "J"
        Prompt        base64 "SjogSW5lcnRpYSAoa2dtwrIpLCBbXSA9IHRoZSBtb2RlbCBub3QgdXNlZA=="
        Type          FreeText
        Value         "cfg.J"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "cfg.T_s"
        Show          off
        Tunable       on
        TabName       ""
      }
