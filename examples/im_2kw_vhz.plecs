      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/im_current_vector.c\"\n#include \"../motulator_export/c/im_flux_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Disabled: the algorithm is not run */\nif (!(InputSignal(0, 0) > 0.0)) {\n    for (int k = 0; k < 2; k++) {\n        OutputSignal(0, k) = 0.0;\n    }\n    for (int k = 0; k < 2; k++) {\n        OutputSignal(1, k) = 0.0;\n    }\n    for (int k = 0; k < 3; k++) {\n        OutputSignal(2, k) = 0.0;\n    }\n    for (int k = 0; k < 2; k++) {\n        OutputSignal(3, k) = 0.0;\n    }\n    return;\n}\n\ndouble fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(1, k);\n}\nIMObserverOutputs fbk;\nim_observer_outputs_unpack(fbk_u, &fbk);\ndouble ref_u[VHZ_REF_WIDTH];\nfor (int k = 0; k < VHZ_REF_WIDTH; k++) {\n    ref_u[k] = InputSignal(2, k);\n}\nIMVHzReferences ref;\nim_vhz_references_unpack(ref_u, &ref);\n/* Monitored signals */\n/* The current in estimated rotor flux coordinates */\ndouble complex rot = cexp(-I * carg(fbk.psi_R));\nOutputSignal(0, 0) = InputSignal(3, 0);\nOutputSignal(0, 1) = fbk.w_s;\nOutputSignal(1, 0) = ref.tau_M;\nOutputSignal(1, 1) = fbk.tau_M;\nOutputSignal(2, 0) = ref.psi_s;\nOutputSignal(2, 1) = cabs(fbk.psi_s);\nOutputSignal(2, 2) = cabs(fbk.psi_R);\nOutputSignal(3, 0) = creal(rot * fbk.i_s);\nOutputSignal(3, 1) = cimag(rot * fbk.i_s);\n"
        Show          off
      }
