    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [175, 60]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[1 3 2 2]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[10 2]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[1 1 1 1]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "n_p, T_s, u_s_ref_u_0, u_s_ref_k"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/im_open_loop_vhz.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\nstatic IMOpenLoopVHzController self;\nstatic double T_s; /* Sampling period */\nstatic IMOpenLoopVHzFeedbacks fbk;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(0) != 1) {\n    SetErrorMessage(\"n_p must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 2 || PDIM(3) != 2) {\n    SetErrorMessage(\"u_s_ref.u_0 and u_s_ref.k must be [real part, imaginary part].\");\n    return;\n}\nT_s = P(1, 0);\nim_open_loop_vhz_ctrl_init(&self, P(0, 0),\n                           complex_from(P(2, 0), P(2, 1)),\n                           complex_from(P(3, 0), P(3, 1)), T_s);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double meas_u[OLVHZ_MEAS_WIDTH];\nfor (int k = 0; k < OLVHZ_MEAS_WIDTH; k++) {\n    meas_u[k] = InputSignal(1, k);\n}\nIMOpenLoopVHzMeasurements meas;\nim_open_loop_vhz_measurements_unpack(meas_u, &meas);\n/* Feedback signals, the voltage of the ongoing period NAN if unknown */\nim_open_loop_vhz_ctrl_get_feedback(&self, complex_from(InputSignal(3, 0), InputSignal(3, 1)),\n                                   meas.i_c_ab, InputSignal(0, 0), &fbk);\n/* Voltage for the control laws (DriveControlSystem.get_feedback), or\n * u_s_zoh if unknown */\ndouble complex u_c_ab = complex_from(InputSignal(2, 0), InputSignal(2, 1));\nfbk.u_s = isnan(creal(u_c_ab)) ? fbk.u_s_zoh\n                               : cexp(-I * fbk.theta_c) * u_c_ab;\ndouble y[OLVHZ_FBK_WIDTH];\nim_open_loop_vhz_feedbacks_pack(&fbk, y);\nfor (int k = 0; k < OLVHZ_FBK_WIDTH; k++) {\n    OutputSignal(0, k) = y[k];\n}\n/* Stator voltage reference (ref.u_s) */\ndouble complex u_s_ref = im_open_loop_vhz_ctrl_compute_output(&self, &fbk);\nOutputSignal(1, 0) = creal(u_s_ref);\nOutputSignal(1, 1) = cimag(u_s_ref);\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "im_open_loop_vhz_ctrl_update(&self, T_s, &fbk);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
