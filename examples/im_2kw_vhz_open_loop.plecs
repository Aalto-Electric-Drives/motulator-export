    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [125, 45]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-30, -15; 30, 15]
      Parameter {
        Variable      "DialogGeometry"
