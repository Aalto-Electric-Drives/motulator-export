        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/im_current_vector.c\"\n#include \"../motulator_export/c/im_flux_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\nstatic RateLimiter self;\nstatic double T_s; /* Sampling period */\nstatic double y;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(0) != 1) {\n    SetErrorMessage(\"rate_limit must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nrate_limiter_init(&self, P(0, 0));\nT_s = P(1, 0);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "y = rate_limiter_compute_output(&self, T_s, InputSignal(0, 0));\nOutputSignal(0, 0) = y;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "rate_limiter_update(&self, y);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
    Connection {
      Type          Signal
      SrcComponent  "u"
      SrcTerminal   1
      Points        [70, 35; 70, 45]
      DstComponent  "C-Script"
      DstTerminal   1
    }
    Connection {
      Type          Signal
      SrcComponent  "C-Script"
      SrcTerminal   2
      DstComponent  "y"
      DstTerminal   1
    }
      }
    }
    Component {
      Type          Subsystem
      Name          "PWM"
      Show          on
      Position      [450, 215]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -50; 50, 50]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "PWM (motulator)"
      MaskDescription "Space-vector PWM with the minimum-phase-error (MPE) or the minimum-magnitude-error (MME) overmodulation (PWM), with the duty-ratio error model d_err = InverterNonlinearity(t_d, u_th, sign) and its compensation, the minimum pulses, and the single update. The blocks inside are its methods compute_output and get_realized_voltage. While the gates are blocked (the input enable is zero), the realized voltage is unknown (NaN), so the observers run on their open-circuit model, as in get_feedback of the control system."
      MaskInit      "% MME overmodulation, or MPE\nmme = strcmp(overmodulation, 'MME');\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "T_s"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "t_d"
        Prompt        "t_d: Dead time (s) in d_err = InverterNonlinearity(t_d, u_th, sign)"
        Type          FreeText
        Value         "pwm.t_d"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "u_th"
        Prompt        "u_th: Threshold voltage (V) in InverterNonlinearity (d_err = None if t_d = u_th = 0)"
        Type          FreeText
        Value         "pwm.u_th"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "i_0"
        Prompt        "i_0: Current scale (A) of sign = tanh(i/i_0) in InverterNonlinearity, 0 = np.sign"
        Type          FreeText
        Value         "pwm.i_0"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "feedforward"
        Prompt        "feedforward: Compensate for d_err (1) or not (0)"
        Type          FreeText
        Value         "pwm.feedforward"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "d_min"
        Prompt        "d_min: Minimum duty ratio of a switching leg, 0 = no limit"
        Type          FreeText
        Value         "pwm.d_min"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "single_update"
        Prompt        "single_update: Duty ratios updated once (1) or twice (0) per carrier period"
        Type          FreeText
        Value         "pwm.single_update"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "overmodulation"
        Prompt        "overmodulation: Overmodulation, 'MPE' or 'MME'"
        Type          FreeText
        Value         "pwm.overmodulation"
        Show          off
        Tunable       on
        TabName       ""
      }
