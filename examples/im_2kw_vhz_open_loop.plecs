      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[OLVHZ_FBK_WIDTH];\nfor (int k = 0; k < OLVHZ_FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(0, k);\n}\nIMOpenLoopVHzFeedbacks fbk;\nim_open_loop_vhz_feedbacks_unpack(fbk_u, &fbk);\ndouble ref_u[OLVHZ_REF_WIDTH];\nfor (int k = 0; k < OLVHZ_REF_WIDTH; k++) {\n    ref_u[k] = InputSignal(1, k);\n}\nIMOpenLoopVHzReferences ref;\nim_open_loop_vhz_references_unpack(ref_u, &ref);\n/* Monitored signals */\nOutputSignal(0, 0) = InputSignal(2, 0);\nOutputSignal(0, 1) = fbk.w_s;\nOutputSignal(1, 0) = cabs(ref.u_s);\nOutputSignal(1, 1) = cabs(fbk.u_s);\nOutputSignal(2, 0) = creal(fbk.i_s);\nOutputSignal(2, 1) = cimag(fbk.i_s);\n"
