Plecs {
  Name          "im_2kw_vhz_open_loop"
  Version       "5.0"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "1.6"
  Solver        "dopri"
  MaxStep       "cfg.T_s"
  InitStep      "-1"
  RelTol        "1e-6"
  AbsTol        "-1"
  InitializationCommands "% Generated from motulator. The blocks of the control system have masks of the\n% arguments of their classes, which refer to the structs below, as in the\n% motulator API.\n\n%% System model\nmachine.n_p = 2;\nmachine.R_s = 3.7;\nmachine.R_R = 2.1;\nmachine.L_sgm = 0.021;\nmachine.L_M = 0.224;\nmechanics.J = 0.015;\nmechanics.w_M0 = 0;\nmechanics.theta_M0 = 0;\nconverter.u_dc = 540;\n\n%% Control system ([] = None, the default)\n% Machine model of the control system (InductionMachineInvGammaPars, L_M = inf: pure open-loop V/Hz control)\npar.n_p = 2;\npar.R_s = 0;\npar.R_R = 0;\npar.L_sgm = 0;\npar.L_M = inf;\n% Observer-based V/Hz control (ObserverBasedVHzControllerCfg)\ncfg.psi_s_nom = 1.0395957349782348;\ncfg.i_s_max = inf;\ncfg.alpha_psi = 0;\ncfg.alpha_tau = 0;\ncfg.alpha_f = 0;\ncfg.k_u = 0.9;\ncfg.k_b = 0.9;\ncfg.T_s = 0.00025;\n% V/Hz controller (ObserverBasedVHzController)\nvhz_ctrl.par = par;\nvhz_ctrl.cfg = cfg;\n% Slew rate of the speed reference (VHzControlSystem), mechanical rad/s^2\nslew_rate = 2*pi*60;\n% PWM: the duty-ratio error model d_err = InverterNonlinearity(t_d, u_th,\n% sign) with sign = tanh(i/i_0) (np.sign if i_0 = 0, no error model if\n% t_d = u_th = 0), its compensation, the minimum duty ratio of a switching\n% leg, the single update (1) or the double update (0) of the duty ratios,\n% and the overmodulation ('MPE' or 'MME')\npwm.t_d = 0;\npwm.u_th = 0;\npwm.i_0 = 0;\npwm.feedforward = 1;\npwm.d_min = 0;\npwm.single_update = 0;\npwm.overmodulation = 'MME';\n"
  Schematic {
    Location      [0, 0; 1000, 520]
    ZoomFactor    1
    SliderPosition [0, 0]
    ShowBrowser   off
    BrowserWidth  100
    Component {
      Type          Constant
      Name          "enable"
      Show          on
      Position      [60, 25]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Value"
        Value         "1.0"
        Show          off
      }
    }
    Component {
      Type          Goto
      Name          "Goto enable"
      Show          off
      Position      [195, 10]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Tag"
        Value         "enable"
        Show          off
      }
      Parameter {
        Variable      "Visibility"
        Value         "2"
        Show          off
      }
    }
    Component {
      Type          Step
      Name          "w_M_ref"
      Show          on
      Position      [60, 75]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Time"
        Value         "0.199875"
        Show          off
      }
      Parameter {
        Variable      "Before"
        Value         "0.0"
        Show          off
      }
      Parameter {
        Variable      "After"
        Value         "157.07963267948966"
        Show          off
      }
      Parameter {
        Variable      "DataType"
        Value         "10"
        Show          off
      }
    }
    Component {
      Type          PlecsProbe
      Name          "i_s_abc"
      Show          on
      Position      [60, 125]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "Machine"
        Path          ""
        Signals       {"Stator phase currents"}
      }
    }
    Component {
      Type          PlecsProbe
      Name          "u_dc meas."
      Show          on
      Position      [60, 175]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "u_dc"
        Path          ""
        Signals       {"Measured voltage"}
      }
    }
    Component {
      Type          Subsystem
      Name          "Observer-based VHz control"
      Show          on
      Position      [250, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Observer-based VHz control (motulator)"
      MaskDescription "Observer-based V/Hz control of an induction machine drive, or pure open-loop V/Hz control if L_M = inf (VHzControlSystem with ObserverBasedVHzController). The speed reference is in mechanical rad/s. Each class of motulator is a block with a mask of its arguments, nested as in motulator: the arguments of VHzControlSystem are structs of the arguments of its parts, from which the blocks inside get their parameters as in the constructors of motulator. The sampling period is cfg.T_s of the inner controller. The input enable is the gate enable (ControlSystem.set_enable): while it is zero, the control system runs in standby for the blocked gates, computing its standby output without measuring the converter voltage, as in motulator."
      MaskInit      "T_s = vhz_ctrl.cfg.T_s;\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "vhz_ctrl"
        Prompt        "vhz_ctrl: V/Hz controller (ObserverBasedVHzController) as a struct: par, cfg"
        Type          FreeText
        Value         "vhz_ctrl"
        Show          off
        Tunable       on
        TabName       "VHzControlSystem"
      }
      Parameter {
        Variable      "slew_rate"
        Prompt        base64 "c2xld19yYXRlOiBTbGV3IHJhdGUgb2YgdGhlIHNwZWVkIHJlZmVyZW5jZSAobWVjaGFuaWNhbCByYWQvc8KyKQ=="
        Type          FreeText
        Value         "slew_rate"
        Show          off
        Tunable       on
        TabName       "VHzControlSystem"
      }
      Parameter {
        Variable      "pwm"
        Prompt        "pwm: PWM as a struct"
        Type          FreeText
        Value         "pwm"
        Show          off
        Tunable       on
        TabName       "VHzControlSystem"
      }
      Terminal {
        Type          Input
        Position      [-50, -15]
        Direction     left
      }
