    Component {
      Type          Subsystem
      Name          "Current-vector control (SM)"
      Show          on
      Position      [250, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Current-vector control (SM) (motulator)"
      MaskDescription "Speed control of a synchronous machine drive with current-vector control (VectorControlSystem with CurrentVectorController and SpeedController). Each class of motulator is a block with a mask of its arguments, nested as in motulator: the arguments of VectorControlSystem are structs of the arguments of its parts, from which the blocks inside get their parameters as in the constructors of motulator. The sampling period is cfg.T_s of the inner controller. The input enable is the gate enable (ControlSystem.set_enable): while it is zero, the control system runs in standby for the blocked gates, computing its standby output without measuring the converter voltage, as in motulator."
      MaskInit      "T_s = vector_ctrl.cfg.T_s;\nsensorless = vector_ctrl.cfg.sensorless;\n% Angle-advance factor (k_comp of the vector controller), zero with the\n% direct discrete-time current controller\nk_comp = 1.5;\nif isfield(vector_ctrl.cfg, 'discrete') && vector_ctrl.cfg.discrete\n  k_comp = 0;\nend\n% Initial speed estimate of the observer, zero if not given (e.g., in a\n% model written before the initial state of the observer was exported)\nif ~isfield(vector_ctrl, 'observer') || ~isfield(vector_ctrl.observer, 'w_M')\n  vector_ctrl.observer.w_M = 0;\nend\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "vector_ctrl"
        Prompt        "vector_ctrl: Vector controller (CurrentVectorController) as a struct: par, cfg, observer"
