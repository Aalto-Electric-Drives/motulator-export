    Component {
      Type          CScript
      Name          "get_measurement"
      Show          on
      Position      [275, 195]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -25; 50, 25]
      Parameter {
        Variable      "DialogGeometry"
