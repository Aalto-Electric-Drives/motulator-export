    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [175, 60]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[2 23 2 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[2]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[1 1 0 0]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "alpha_c, alpha_i, discrete, T_s, par_n_p, par_R_s, par_L_d, par_L_q, par_psi_f, gn_in_dim, gn_mu_dim, gn_W, gn_b, gn_mu_log, gn_bias, gn_activation, gn_beta_log, gn_p, gn_in_base, gn_out_base"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/gradnet.c\"\n#include \"../motulator_export/c/sm_parameters.c\"\n#include \"../motulator_export/c/sm_control_loci.c\"\n#include \"../motulator_export/c/sm_flux_vector.c\"\n#include \"../motulator_export/c/sm_current_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n/* Check that a GradNet in the parameters i0, i0 + 1, ... (GRADNET_FIELDS) fits\n * in the arrays of the C port (in the start function only, returns on error) */\n#define CHECK_GRADNET(i0) \\\n    do { \\\n        if ((int)P((i0), 0) > GRADNET_MAX_IN_DIM \\\n            || PDIM((i0) + 3) > GRADNET_MAX_EMBED_DIM) { \\\n            SetErrorMessage(\"GradNet too large: in_dim must be at most \" \\\n                            \"4 and embed_dim at most \" \\\n                            \"64.\"); \\\n            return; \\\n        } \\\n    } while (0)\n\n/* Read a GradNet from the parameters i0, i0 + 1, ... (GRADNET_FIELDS) */\n#define READ_GRADNET(net, i0) \\\n    do { \\\n        (net).in_dim = (int)P((i0), 0); \\\n        (net).mu_dim = (int)P((i0) + 1, 0); \\\n        (net).embed_dim = PDIM((i0) + 3); \\\n        for (int j_ = 0; j_ < (net).embed_dim; j_++) { \\\n            for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n                (net).W[j_][k_] = P((i0) + 2, j_ + (net).embed_dim * k_); \\\n            } \\\n            (net).b[j_] = P((i0) + 3, j_); \\\n        } \\\n        for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n            (net).mu_log[k_] = (k_ < (net).mu_dim) ? P((i0) + 4, k_) : 0.0; \\\n            (net).bias[k_] = P((i0) + 5, k_); \\\n        } \\\n        (net).activation = (GradNetActivation)(int)P((i0) + 6, 0); \\\n        (net).beta_log = P((i0) + 7, 0); \\\n        (net).p = (int)P((i0) + 8, 0); \\\n        (net).in_base = P((i0) + 9, 0); \\\n        (net).out_base = P((i0) + 10, 0); \\\n    } while (0)\n\nstatic SMCurrentController self;\nstatic double T_s; /* Sampling period */\nstatic ObserverOutputs fbk;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(0) != 1) {\n    SetErrorMessage(\"alpha_c must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 1) {\n    SetErrorMessage(\"discrete must be a scalar.\");\n    return;\n}\nif (PDIM(3) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\n/* Machine model: SaturatedSynchronousMachinePars with a GradNet flux map,\n * or SynchronousMachinePars with constant inductances */\nSynchronousMachinePars par;\nif (PDIM(9) > 0) {\n    GradNet flux_map;\n    CHECK_GRADNET(9);\n    READ_GRADNET(flux_map, 9);\n    par = saturated_synchronous_machine_pars(P(4, 0), P(5, 0),\n                                             &flux_map);\n} else {\n    if (PDIM(6) != 1 || PDIM(7) != 1 || PDIM(8) != 1) {\n        SetErrorMessage(\"L_d, L_q, and psi_f needed without a flux map.\");\n        return;\n    }\n    par = synchronous_machine_pars(P(4, 0), P(5, 0), P(6, 0),\n                                   P(7, 0), P(8, 0));\n}\nsm_current_ctrl_init(&self, par, P(0, 0), PARAM(1),\n                     (int)P(2, 0), P(3, 0));\nT_s = P(3, 0);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(1, k);\n}\nobserver_outputs_unpack(fbk_u, &fbk);\n/* Preset at the back-EMF of the caught speed\n * (CurrentVectorController.get_feedback) */\nif (fbk.caught) {\n    sm_current_ctrl_preset(&self, I * fbk.w_m * fbk.psi_f, fbk.w_c);\n}\ndouble complex u_s_ref =\n    sm_current_ctrl_compute_output(&self, complex_from(InputSignal(0, 0), InputSignal(0, 1)), fbk.i_s);\nOutputSignal(0, 0) = creal(u_s_ref);\nOutputSignal(0, 1) = cimag(u_s_ref);\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "/* The discrete-time controller takes its limited output, except with blocked\n * gates, when the open-circuit voltage of the observer is the realized one */\ndouble complex u = fbk.u_s;\nif (self.discrete && InputSignal(3, 0) > 0.0) {\n    u = cexp(-I * fbk.theta_c) * complex_from(InputSignal(2, 0), InputSignal(2, 1));\n}\nsm_current_ctrl_update(&self, T_s, u, fbk.w_c);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
