    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [165, 55]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -25; 50, 25]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[1 1 23]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[2 2]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[1 1 1]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "i_s_max, psi_s_min, psi_s_max, k_u, k_mtpv, alpha_ref, T_s, par_n_p, par_R_s, par_L_d, par_L_q, par_psi_f, gn_in_dim, gn_mu_dim, gn_W, gn_b, gn_mu_log, gn_bias, gn_activation, gn_beta_log, gn_p, gn_in_base, gn_out_base, luts"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/gradnet.c\"\n#include \"../motulator_export/c/sm_parameters.c\"\n#include \"../motulator_export/c/sm_control_loci.c\"\n#include \"../motulator_export/c/sm_flux_vector.c\"\n#include \"../motulator_export/c/sm_current_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n/* Check that a GradNet in the parameters i0, i0 + 1, ... (GRADNET_FIELDS) fits\n * in the arrays of the C port (in the start function only, returns on error) */\n#define CHECK_GRADNET(i0) \\\n    do { \\\n        if ((int)P((i0), 0) > GRADNET_MAX_IN_DIM \\\n            || PDIM((i0) + 3) > GRADNET_MAX_EMBED_DIM) { \\\n            SetErrorMessage(\"GradNet too large: in_dim must be at most \" \\\n                            \"4 and embed_dim at most \" \\\n                            \"64.\"); \\\n            return; \\\n        } \\\n    } while (0)\n\n/* Read a GradNet from the parameters i0, i0 + 1, ... (GRADNET_FIELDS) */\n#define READ_GRADNET(net, i0) \\\n    do { \\\n        (net).in_dim = (int)P((i0), 0); \\\n        (net).mu_dim = (int)P((i0) + 1, 0); \\\n        (net).embed_dim = PDIM((i0) + 3); \\\n        for (int j_ = 0; j_ < (net).embed_dim; j_++) { \\\n            for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n                (net).W[j_][k_] = P((i0) + 2, j_ + (net).embed_dim * k_); \\\n            } \\\n            (net).b[j_] = P((i0) + 3, j_); \\\n        } \\\n        for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n            (net).mu_log[k_] = (k_ < (net).mu_dim) ? P((i0) + 4, k_) : 0.0; \\\n            (net).bias[k_] = P((i0) + 5, k_); \\\n        } \\\n        (net).activation = (GradNetActivation)(int)P((i0) + 6, 0); \\\n        (net).beta_log = P((i0) + 7, 0); \\\n        (net).p = (int)P((i0) + 8, 0); \\\n        (net).in_base = P((i0) + 9, 0); \\\n        (net).out_base = P((i0) + 10, 0); \\\n    } while (0)\n\nstatic ReferenceGenerator self;\nstatic double T_s; /* Sampling period */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(5) != 1) {\n    SetErrorMessage(\"alpha_ref must be a scalar.\");\n    return;\n}\nif (PDIM(6) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nif (PDIM(0) != 1) {\n    SetErrorMessage(\"i_s_max must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 1) {\n    SetErrorMessage(\"psi_s_max must be a scalar.\");\n    return;\n}\nif (PDIM(3) != 1) {\n    SetErrorMessage(\"k_u must be a scalar.\");\n    return;\n}\nif (PDIM(4) != 1) {\n    SetErrorMessage(\"k_mtpv must be a scalar.\");\n    return;\n}\n/* Machine model: SaturatedSynchronousMachinePars with a GradNet flux map,\n * or SynchronousMachinePars with constant inductances */\nSynchronousMachinePars par;\nif (PDIM(12) > 0) {\n    GradNet flux_map;\n    CHECK_GRADNET(12);\n    READ_GRADNET(flux_map, 12);\n    par = saturated_synchronous_machine_pars(P(7, 0), P(8, 0),\n                                             &flux_map);\n} else {\n    if (PDIM(9) != 1 || PDIM(10) != 1 || PDIM(11) != 1) {\n        SetErrorMessage(\"L_d, L_q, and psi_f needed without a flux map.\");\n        return;\n    }\n    par = synchronous_machine_pars(P(7, 0), P(8, 0), P(9, 0),\n                                   P(10, 0), P(11, 0));\n}\n/* Lookup tables of the loci: given (sm_reference_luts.m in Simulink), or\n * computed at the start if empty (PLECS) */\nReferenceLUTs luts_given;\nconst ReferenceLUTs *luts = NULL;\nif (PDIM(23) > 0) {\n    if (PDIM(23) != 6 * NUM_LOCUS) {\n        SetErrorMessage(\"luts must be a 16-by-6 matrix (sm_reference_luts.m) or empty.\");\n        return;\n    }\n    LUT *tables[3] = {&luts_given.psi_s_mtpa, &luts_given.tau_M_cl,\n                      &luts_given.tau_M_mtpv};\n    for (int t = 0; t < 3; t++) {\n        tables[t]->n = NUM_LOCUS;\n        for (int k = 0; k < NUM_LOCUS; k++) {\n            tables[t]->x[k] = P(23, 2 * t * NUM_LOCUS + k);\n            tables[t]->y[k] = P(23, (2 * t + 1) * NUM_LOCUS + k);\n        }\n    }\n    luts = &luts_given;\n}\nreference_gen_init(&self, &par, P(0, 0), PARAM(1),\n                   P(2, 0), P(3, 0), P(4, 0), luts);\n/* Errors of ReferenceGenerator of motulator */\nconst char *error = reference_gen_error(&self, &par);\nif (error != NULL) {\n    SetErrorMessage(error);\n    return;\n}\nself.alpha = P(5, 0);\nT_s = P(6, 0);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(2, k);\n}\nObserverOutputs fbk;\nobserver_outputs_unpack(fbk_u, &fbk);\n/* Restart from zero current when the observer catches the machine\n * (CurrentVectorController.get_feedback) */\nif (fbk.caught) {\n    self.i_s_ref = 0.0;\n}\n/* Flux and limited torque references (ref.psi_s, ref.tau_M), and the\n * current reference (ref.i_s) */\ndouble psi_s_ref, tau_M_ref;\nreference_gen_compute_flux_and_torque_refs(&self, InputSignal(0, 0), fbk.w_m,\n    InputSignal(1, 0), &psi_s_ref, &tau_M_ref);\ndouble complex i_s_ref =\n    reference_gen_compute_current_ref(&self, psi_s_ref, tau_M_ref);\nOutputSignal(0, 0) = psi_s_ref;\nOutputSignal(0, 1) = tau_M_ref;\nOutputSignal(1, 0) = creal(i_s_ref);\nOutputSignal(1, 1) = cimag(i_s_ref);\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "reference_gen_update(&self, T_s);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
