      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(0, k);\n}\nObserverOutputs fbk;\nobserver_outputs_unpack(fbk_u, &fbk);\ndouble ref_u[CVC_REF_WIDTH];\nfor (int k = 0; k < CVC_REF_WIDTH; k++) {\n    ref_u[k] = InputSignal(1, k);\n}\nReferences ref;\ncvc_references_unpack(ref_u, &ref);\n/* Monitored signals */\nOutputSignal(0, 0) = InputSignal(2, 0);\nOutputSignal(0, 1) = fbk.w_M;\nOutputSignal(1, 0) = ref.tau_M;\nOutputSignal(1, 1) = fbk.tau_M;\nOutputSignal(2, 0) = ref.psi_s;\nOutputSignal(2, 1) = cabs(fbk.psi_s);\nOutputSignal(3, 0) = creal(ref.i_s);\nOutputSignal(3, 1) = creal(fbk.i_s);\nOutputSignal(3, 2) = cimag(ref.i_s);\nOutputSignal(3, 3) = cimag(fbk.i_s);\n"
