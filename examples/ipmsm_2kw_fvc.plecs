    Component {
      Type          Subsystem
      Name          "SpeedFluxObserver"
      Show          on
      Position      [285, 200]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -50; 50, 50]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "SpeedFluxObserver (motulator)"
      MaskDescription "Flux observer with speed estimation, created by create_speed_flux_observer. The mask initialization computes the gains of the SpeedObserver and the FluxObserver inside it, as in SpeedFluxObserver. The machine model par is a struct with the fields n_p, R_s, L_d, L_q, and psi_f of SynchronousMachinePars, or n_p, R_s, and psi_s_dq_fcn (a GradNet flux map) of SaturatedSynchronousMachinePars."
      MaskInit      "% Default observer gain of create_speed_flux_observer, k_o(w_m) = k0 +\n% k1*abs(w_m) (k0 = NaN: sigma0 of the machine model, see the FluxObserver)\nk_o_obs = k_o;\nif isempty(k_o_obs)\n  if sensorless\n    k_o_obs = [NaN 0.2];\n  else\n    k_o_obs = [2*pi*15 0];\n  end\nend\n% Gains for critically damped dynamics (SpeedFluxObserver.__init__)\nif isempty(J)\n  k_theta = 2*alpha_o;\n  k_w = alpha_o^2;\n  k_tau = 0;\nelse\n  k_theta = 3*alpha_o;\n  k_w = 3*alpha_o^2;\n  k_tau = J*alpha_o^3;\nend\n% Weight of the measured rotor angle in the FluxObserver (position_error)\nh = 1 - sensorless;\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "par"
        Prompt        "par: Machine model (SynchronousMachinePars, or SaturatedSynchronousMachinePars with a GradNet flux map psi_s_dq_fcn) as a struct"
        Type          FreeText
        Value         "par"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "alpha_o"
        Prompt        "alpha_o: Speed estimation pole (rad/s)"
        Type          FreeText
        Value         "alpha_o"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain [k0 k1], k_o(w_m) = k0 + k1*abs(w_m), [] = default"
        Type          FreeText
        Value         "cfg.k_o"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_f"
        Prompt        "k_f: PM-flux estimation gain, only [] (zero)"
        Type          FreeText
        Value         "cfg.k_f"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "sensorless"
        Prompt        "sensorless: Sensorless mode (1) or sensored mode (0)"
        Type          FreeText
        Value         "cfg.sensorless"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "J"
        Prompt        base64 "SjogSW5lcnRpYSAoa2dtwrIpLCBbXSA9IHRoZSBtb2RlbCBub3QgdXNlZA=="
        Type          FreeText
        Value         "cfg.J"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "cfg.T_s"
        Show          off
        Tunable       on
        TabName       ""
      }
      Terminal {
        Type          Input
        Position      [-50, -30]
        Direction     left
