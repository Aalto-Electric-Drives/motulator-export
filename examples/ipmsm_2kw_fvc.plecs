      Show          on
      Position      [60, 100]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "Machine"
        Path          ""
        Signals       {"Stator phase currents"}
      }
    }
    Component {
      Type          PlecsProbe
      Name          "u_dc meas."
      Show          on
      Position      [60, 140]
      Direction     right
      Flipped       off
      LabelPosition south
