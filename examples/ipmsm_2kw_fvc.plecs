    Component {
      Type          CScript
      Name          "modulate"
      Show          on
      Position      [1035, 140]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -20; 50, 20]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[22 2]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[2 1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
