        Prompt        "psi_f: PM-flux linkage (Vs)"
        Type          FreeText
        Value         "0.545"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "i_s_max"
        Prompt        "i_s_max: Maximum stator current (A)"
        Type          FreeText
        Value         "6.5"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_tau"
        Prompt        "alpha_tau: Torque-control bandwidth (rad/s)"
        Type          FreeText
        Value         "2*pi*100"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_psi"
        Prompt        "alpha_psi: Flux-control bandwidth (rad/s), [] = alpha_tau"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_i"
        Prompt        "alpha_i: Integral-action bandwidth (rad/s), [] = alpha_tau"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "alpha_o"
        Prompt        "alpha_o: Speed estimation pole (rad/s), [] = default"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain [k0 k1], k_o(w_m) = k0 + k1*abs(w_m), [] = default"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "psi_s_min"
        Prompt        "psi_s_min: Minimum stator flux (Vs), [] = psi_f"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
