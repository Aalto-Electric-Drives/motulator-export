        Value         "0.036"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "L_q"
        Prompt        "L_q: q-axis inductance (H)"
        Type          FreeText
        Value         "0.051"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
