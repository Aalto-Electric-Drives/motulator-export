    Component {
      Type          CScript
      Name          "get_measurement"
      Show          on
      Position      [220, 195]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -25; 50, 25]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[3 1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[4]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
