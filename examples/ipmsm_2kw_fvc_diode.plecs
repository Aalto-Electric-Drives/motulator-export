    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [175, 60]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[4 2 2 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[2 23]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[1 1 1 1]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "k_theta, k_o, k_f, h, T_s, par_n_p, par_R_s, par_L_d, par_L_q, par_psi_f, gn_in_dim, gn_mu_dim, gn_W, gn_b, gn_mu_log, gn_bias, gn_activation, gn_beta_log, gn_p, gn_in_base, gn_out_base"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../motulator_export/c/common.c\"\n#include \"../motulator_export/c/gradnet.c\"\n#include \"../motulator_export/c/sm_parameters.c\"\n#include \"../motulator_export/c/sm_control_loci.c\"\n#include \"../motulator_export/c/sm_flux_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n/* Check that a GradNet in the parameters i0, i0 + 1, ... (GRADNET_FIELDS) fits\n * in the arrays of the C port (in the start function only, returns on error) */\n#define CHECK_GRADNET(i0) \\\n    do { \\\n        if ((int)P((i0), 0) > GRADNET_MAX_IN_DIM \\\n            || PDIM((i0) + 3) > GRADNET_MAX_EMBED_DIM) { \\\n            SetErrorMessage(\"GradNet too large: in_dim must be at most \" \\\n                            \"4 and embed_dim at most \" \\\n                            \"64.\"); \\\n            return; \\\n        } \\\n    } while (0)\n\n/* Read a GradNet from the parameters i0, i0 + 1, ... (GRADNET_FIELDS) */\n#define READ_GRADNET(net, i0) \\\n    do { \\\n        (net).in_dim = (int)P((i0), 0); \\\n        (net).mu_dim = (int)P((i0) + 1, 0); \\\n        (net).embed_dim = PDIM((i0) + 3); \\\n        for (int j_ = 0; j_ < (net).embed_dim; j_++) { \\\n            for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n                (net).W[j_][k_] = P((i0) + 2, j_ + (net).embed_dim * k_); \\\n            } \\\n            (net).b[j_] = P((i0) + 3, j_); \\\n        } \\\n        for (int k_ = 0; k_ < (net).in_dim; k_++) { \\\n            (net).mu_log[k_] = (k_ < (net).mu_dim) ? P((i0) + 4, k_) : 0.0; \\\n            (net).bias[k_] = P((i0) + 5, k_); \\\n        } \\\n        (net).activation = (GradNetActivation)(int)P((i0) + 6, 0); \\\n        (net).beta_log = P((i0) + 7, 0); \\\n        (net).p = (int)P((i0) + 8, 0); \\\n        (net).in_base = P((i0) + 9, 0); \\\n        (net).out_base = P((i0) + 10, 0); \\\n    } while (0)\n\nstatic FluxObserver self;\nstatic double T_s; /* Sampling period */\nstatic double h;\nstatic ObserverOutputs out;\n/* Current at the start of the latest sampling period with an unknown\n * voltage, NAN if the voltage is known */\nstatic double complex i_s_ab_prev;\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(0) != 1) {\n    SetErrorMessage(\"k_theta must be a scalar.\");\n    return;\n}\nif (PDIM(3) != 1) {\n    SetErrorMessage(\"h must be a scalar.\");\n    return;\n}\nif (PDIM(4) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 2) {\n    SetErrorMessage(\"k_o must be [k0 k1].\");\n    return;\n}\nif (PDIM(2) > 0 && P(2, 0) != 0.0) {\n    SetErrorMessage(\"Only k_f = [] (zero) supported.\");\n    return;\n}\n/* Machine model: SaturatedSynchronousMachinePars with a GradNet flux map,\n * or SynchronousMachinePars with constant inductances */\nSynchronousMachinePars par;\nif (PDIM(10) > 0) {\n    GradNet flux_map;\n    CHECK_GRADNET(10);\n    READ_GRADNET(flux_map, 10);\n    par = saturated_synchronous_machine_pars(P(5, 0), P(6, 0),\n                                             &flux_map);\n} else {\n    if (PDIM(7) != 1 || PDIM(8) != 1 || PDIM(9) != 1) {\n        SetErrorMessage(\"L_d, L_q, and psi_f needed without a flux map.\");\n        return;\n    }\n    par = synchronous_machine_pars(P(5, 0), P(6, 0), P(7, 0),\n                                   P(8, 0), P(9, 0));\n}\ndouble k_o[2] = {P(1, 0), P(1, 1)};\nif (isnan(k_o[0])) {\n    /* Poles at zero speed at s = 0 and s = -2*sigma0 */\n    IncrIndMat L_s0 = incr_ind_mat(&par, 0.0);\n    k_o[0] = 0.25 * par.R_s * (1.0 / L_s0.L_dd + 1.0 / L_s0.L_qq);\n}\nflux_observer_init(&self, par, P(0, 0), k_o);\nT_s = P(4, 0);\nh = P(3, 0);\ni_s_ab_prev = NAN;\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double meas_u[MEAS_WIDTH];\nfor (int k = 0; k < MEAS_WIDTH; k++) {\n    meas_u[k] = InputSignal(0, k);\n}\nMeasurements meas;\nmeasurements_unpack(meas_u, &meas);\ndouble complex u_s_ab = complex_from(InputSignal(1, 0), InputSignal(1, 1));\ndouble complex u_s_zoh_ab = complex_from(InputSignal(2, 0), InputSignal(2, 1));\ndouble w_M = InputSignal(3, 0);\n/* Flying start when the voltage is known again (SpeedFluxObserver), the\n * speed estimate initialized by the output init */\nint caught = flux_observer_flying_start(&self, &i_s_ab_prev, u_s_zoh_ab,\n                                        meas.i_c_ab, h, &w_M);\nOutputSignal(0, 0) = caught;\nOutputSignal(0, 1) = w_M;\nif (h == 0.0) {\n    flux_observer_compute_output(&self, u_s_zoh_ab, meas.i_c_ab, w_M, 0.0,\n                                 0.0, &out);\n} else {\n    /* Position error from the measured rotor angle (compute_feedback) */\n    double n_p = self.par.n_p;\n    double eps = wrap(n_p * meas.theta_M - self.theta_m) / n_p;\n    flux_observer_compute_output(&self, u_s_zoh_ab, meas.i_c_ab, w_M, eps,\n                                 h, &out);\n}\nout.caught = caught;\n/* Voltage for the control laws (DriveControlSystem.get_feedback), or the\n * open-circuit voltage of the observer if unknown */\nout.u_s = isnan(creal(u_s_ab)) ? out.u_s_zoh\n                               : cexp(-I * out.theta_c) * u_s_ab;\ndouble y[FBK_WIDTH];\nobserver_outputs_pack(&out, y);\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    OutputSignal(1, k) = y[k];\n}\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "flux_observer_update(&self, T_s, &out);\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
