    Component {
      Type          Subsystem
      Name          "Flux-vector control"
      Show          on
      Position      [250, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Flux-vector control (motulator)"
      MaskDescription "Speed control of a synchronous machine drive with flux-vector control (VectorControlSystem with FluxVectorController and SpeedController). Each class of motulator is a block with a mask of its arguments, nested as in motulator: the arguments of VectorControlSystem are structs of the arguments of its parts, from which the blocks inside get their parameters as in the constructors of motulator. The sampling period is cfg.T_s of the inner controller. The input enable is the gate enable (ControlSystem.set_enable): while it is zero, the control system runs in standby for the blocked gates, computing its standby output without measuring the converter voltage, as in motulator."
      MaskInit      "T_s = vector_ctrl.cfg.T_s;\nsensorless = vector_ctrl.cfg.sensorless;\n% Angle-advance factor (k_comp of the vector controller), zero with the\n% direct discrete-time current controller\nk_comp = 1.5;\nif isfield(vector_ctrl.cfg, 'discrete') && vector_ctrl.cfg.discrete\n  k_comp = 0;\nend\n% Initial speed estimate of the observer, zero if not given (e.g., in a\n% model written before the initial state of the observer was exported)\nif ~isfield(vector_ctrl, 'observer') || ~isfield(vector_ctrl.observer, 'w_M')\n  vector_ctrl.observer.w_M = 0;\nend\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "vector_ctrl"
        Prompt        "vector_ctrl: Vector controller (FluxVectorController) as a struct: par, cfg, observer"
        Type          FreeText
        Value         "vector_ctrl"
        Show          off
        Tunable       on
        TabName       "VectorControlSystem"
      }
      Parameter {
        Variable      "speed_ctrl"
        Prompt        "speed_ctrl: Speed controller (SpeedController) as a struct"
        Type          FreeText
        Value         "speed_ctrl"
        Show          off
        Tunable       on
        TabName       "VectorControlSystem"
      }
      Parameter {
        Variable      "pwm"
        Prompt        "pwm: PWM as a struct"
        Type          FreeText
        Value         "pwm"
        Show          off
        Tunable       on
        TabName       "VectorControlSystem"
      }
      Terminal {
