        Prompt        "psi_s_max: Maximum stator flux (Vs)"
        Type          FreeText
        Value         "inf"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "k_u"
        Prompt        "k_u: Voltage utilization factor"
        Type          FreeText
        Value         "0.9"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "k_mtpv"
        Prompt        "k_mtpv: MTPV margin"
        Type          FreeText
        Value         "0.85"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "J"
        Prompt        base64 "SjogSW5lcnRpYSAoa2dtwrIpIGZvciB0aGUgc3BlZWQgb2JzZXJ2ZXIsIFtdID0gbm90IHVzZWQ="
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "sensorless"
        Prompt        "sensorless: Sensorless mode (1) or sensored mode (0)"
        Type          FreeText
        Value         "1.0"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "0.000125"
        Show          off
        Tunable       on
        TabName       "Flux-vector control (FluxVectorControllerCfg)"
      }
      Parameter {
