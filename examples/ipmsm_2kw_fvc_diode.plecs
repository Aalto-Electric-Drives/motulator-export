  InitializationCommands "% Generated from motulator. The parameters of the control system are in\n% the mask of the subsystem 'Flux-vector control'.\nmachine.n_p = 3.0;\nmachine.R_s = 3.6;\nmachine.L_d = 0.036;\nmachine.L_q = 0.051;\nmachine.psi_f = 0.545;\nmechanics.J = 0.015;\nconverter.u_dc = 565.685424949238;\nconverter.C_dc = 0.000235;\nconverter.L_dc = 0.002;\nconverter.u_g = 326.5986323710904;\nconverter.w_g = 314.1592653589793;\n"
  Schematic {
    Location      [0, 0; 1320, 560]
    ZoomFactor    1
    SliderPosition [0, 0]
    ShowBrowser   off
    BrowserWidth  100
    Component {
      Type          Step
      Name          "w_M_ref"
      Show          on
      Position      [60, 40]
      Direction     right
      Flipped       off
      LabelPosition south
      Parameter {
        Variable      "Time"
        Value         "0.0999375"
        Show          off
      }
      Parameter {
        Variable      "Before"
        Value         "0.0"
        Show          off
      }
      Parameter {
        Variable      "After"
        Value         "50.0"
        Show          off
      }
      Parameter {
        Variable      "DataType"
        Value         "10"
        Show          off
      }
    }
    Component {
      Type          PlecsProbe
      Name          "i_s_abc"
      Show          on
      Position      [60, 80]
      Direction     right
      Flipped       off
      LabelPosition south
      Probe {
        Component     "Machine"
        Path          ""
        Signals       {"Stator phase currents"}
      }
    }
    Component {
