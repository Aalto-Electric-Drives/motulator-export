    Component {
      Type          Subsystem
      Name          "Flux-vector control"
      Show          on
      Position      [250, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "Flux-vector control (motulator)"
      MaskDescription "Speed control of a synchronous machine drive with flux-vector control. The parameters correspond to the motulator API: SynchronousMachinePars (or SaturatedSynchronousMachinePars with a GradNet flux map), FluxVectorControllerCfg, and SpeedController. Empty parameters ([]) correspond to None, i.e., the defaults of motulator."
      MaskInit      "% Fields of the GradNet flux map for the C-Script\nif isempty(psi_s_dq_fcn)\n  gn_in_dim = [];\n  gn_mu_dim = [];\n  gn_W = [];\n  gn_b = [];\n  gn_mu_log = [];\n  gn_bias = [];\n  gn_activation = [];\n  gn_beta_log = [];\n  gn_p = [];\n  gn_in_base = [];\n  gn_out_base = [];\nelse\n  gn_in_dim = psi_s_dq_fcn.in_dim;\n  gn_mu_dim = psi_s_dq_fcn.mu_dim;\n  gn_W = psi_s_dq_fcn.W;\n  gn_b = psi_s_dq_fcn.b;\n  gn_mu_log = psi_s_dq_fcn.mu_log;\n  gn_bias = psi_s_dq_fcn.bias;\n  gn_activation = psi_s_dq_fcn.activation;\n  gn_beta_log = psi_s_dq_fcn.beta_log;\n  gn_p = psi_s_dq_fcn.p;\n  gn_in_base = psi_s_dq_fcn.in_base;\n  gn_out_base = psi_s_dq_fcn.out_base;\nend\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "n_p"
        Prompt        "n_p: Number of pole pairs"
        Type          FreeText
        Value         "3.0"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "R_s"
        Prompt        base64 "Ul9zOiBTdGF0b3IgcmVzaXN0YW5jZSAozqkp"
        Type          FreeText
        Value         "3.6"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "psi_s_dq_fcn"
        Prompt        "psi_s_dq_fcn: GradNet flux map (SaturatedSynchronousMachinePars), [] = constant inductances"
        Type          FreeText
        Value         "[]"
        Show          off
        Tunable       on
        TabName       "Machine model (SynchronousMachinePars)"
      }
      Parameter {
        Variable      "L_d"
        Prompt        "L_d: d-axis inductance (H)"
