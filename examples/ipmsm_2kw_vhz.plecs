    Component {
      Type          Subsystem
      Name          "ObserverBasedVHzController"
      Show          on
      Position      [670, 90]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -60; 50, 60]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "ObserverBasedVHzController (motulator)"
      MaskDescription "Observer-based V/Hz controller (ObserverBasedVHzController). The configuration cfg is a struct with the fields of ObserverBasedVHzControllerCfg ([] = None, i.e., the default). The mask initialization resolves the defaults and passes the parameters to the blocks inside it, as ObserverBasedVHzController. The block tau_M_lpf is the low-pass filter of the torque estimate, whose output is the torque reference. The machine model par is a struct with the fields n_p, R_s, L_d, L_q, and psi_f of SynchronousMachinePars, or n_p, R_s, and psi_s_dq_fcn (a GradNet flux map) of SaturatedSynchronousMachinePars."
      MaskInit      "% First-order angle estimation, the pole matched to the sampling period\n% (matched_pole)\nk_theta = -expm1(-cfg.alpha_o*cfg.T_s)/cfg.T_s;\n% Default observer gain of create_vhz_observer, k_o(w_m) = k0 + k1*abs(w_m)\n% (k0 = NaN: sigma0 of the machine model, see the FluxObserver)\nk_o = cfg.k_o;\nif isempty(k_o)\n  k_o = [NaN 0.2];\nend\n% Flux and torque controller without the integral action\nalpha_psi = cfg.alpha_psi;\nalpha_i = 0;\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "par"
        Prompt        "par: Machine model (SynchronousMachinePars, or SaturatedSynchronousMachinePars with a GradNet flux map psi_s_dq_fcn) as a struct"
        Type          FreeText
        Value         "vhz_ctrl.par"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "cfg"
        Prompt        "cfg: Configuration (ObserverBasedVHzControllerCfg) as a struct"
        Type          FreeText
        Value         "vhz_ctrl.cfg"
        Show          off
        Tunable       on
        TabName       ""
