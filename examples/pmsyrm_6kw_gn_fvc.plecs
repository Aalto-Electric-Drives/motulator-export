        Value         "pwm.u_th"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "i_0"
        Prompt        "i_0: Current scale (A) of sign = tanh(i/i_0) in InverterNonlinearity, 0 = np.sign"
        Type          FreeText
        Value         "pwm.i_0"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "feedforward"
