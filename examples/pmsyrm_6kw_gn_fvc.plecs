    Component {
      Type          Subsystem
      Name          "FluxObserver"
      Show          on
      Position      [175, 65]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -35; 50, 35]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "FluxObserver (motulator)"
      MaskDescription "Flux observer in estimated rotor coordinates (FluxObserver). The observer uses the voltage u_s_zoh_ab of the ongoing sampling period, and the output fbk.u_s is the voltage u_s_ab averaged over the previous and ongoing periods (DriveControlSystem.get_feedback). While the gates are blocked, the voltages are unknown (NaN), and the observer runs on its open-circuit model. At the flying start after the release (the input step), the estimates are initialized from the current response to the zero-voltage period (SpeedFluxObserver.catch), and the output init = [flag w_M] initializes the SpeedObserver. In the sensored mode (h = 1), the position error signal is computed from the measured rotor angle (compute_feedback). The machine model par is a struct with the fields n_p, R_s, L_d, L_q, and psi_f of SynchronousMachinePars, or n_p, R_s, and psi_s_dq_fcn (a GradNet flux map) of SaturatedSynchronousMachinePars."
      MaskInit      "% Fields of the machine model par for the C-Script: SynchronousMachinePars, or\n% SaturatedSynchronousMachinePars with a GradNet flux map psi_s_dq_fcn\npar_n_p = par.n_p;\npar_R_s = par.R_s;\nif isfield(par, 'psi_s_dq_fcn') && ~isempty(par.psi_s_dq_fcn)\n  par_L_d = [];\n  par_L_q = [];\n  par_psi_f = [];\n  gn_in_dim = par.psi_s_dq_fcn.in_dim;\n  gn_mu_dim = par.psi_s_dq_fcn.mu_dim;\n  gn_W = par.psi_s_dq_fcn.W;\n  gn_b = par.psi_s_dq_fcn.b;\n  gn_mu_log = par.psi_s_dq_fcn.mu_log;\n  gn_bias = par.psi_s_dq_fcn.bias;\n  gn_activation = par.psi_s_dq_fcn.activation;\n  gn_beta_log = par.psi_s_dq_fcn.beta_log;\n  gn_p = par.psi_s_dq_fcn.p;\n  gn_in_base = par.psi_s_dq_fcn.in_base;\n  gn_out_base = par.psi_s_dq_fcn.out_base;\nelse\n  par_L_d = par.L_d;\n  par_L_q = par.L_q;\n  par_psi_f = par.psi_f;\n  gn_in_dim = [];\n  gn_mu_dim = [];\n  gn_W = [];\n  gn_b = [];\n  gn_mu_log = [];\n  gn_bias = [];\n  gn_activation = [];\n  gn_beta_log = [];\n  gn_p = [];\n  gn_in_base = [];\n  gn_out_base = [];\nend\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "par"
        Prompt        "par: Machine model (SynchronousMachinePars, or SaturatedSynchronousMachinePars with a GradNet flux map psi_s_dq_fcn) as a struct"
        Type          FreeText
        Value         "par"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_theta"
        Prompt        "k_theta: Rotor angle estimation gain (rad/s)"
        Type          FreeText
        Value         "k_theta"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain [k0 k1], k_o(w_m) = k0 + k1*abs(w_m), k0 = NaN: sigma0 of the machine model"
        Type          FreeText
        Value         "k_o_obs"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_f"
        Prompt        "k_f: PM-flux estimation gain, only [] (zero)"
        Type          FreeText
