    Component {
      Type          Subsystem
      Name          "SpeedFluxObserver"
      Show          on
      Position      [430, 205]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -50; 50, 50]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "SpeedFluxObserver (motulator)"
      MaskDescription "Flux observer with speed estimation, created by create_speed_flux_observer. The mask initialization resolves the defaults of create_speed_flux_observer and computes the gains of the SpeedObserver and the FluxObserver inside it, as in SpeedFluxObserver. The machine model par is a struct with the fields n_p, R_s, L_d, L_q, and psi_f of SynchronousMachinePars, or n_p, R_s, and psi_s_dq_fcn (a GradNet flux map) of SaturatedSynchronousMachinePars."
      MaskInit      "% Default speed estimation poles of create_speed_flux_observer\n% (default_alpha_o). With J, the triple pole at alpha_o/sqrt(3) keeps the\n% speed gain about the same.\nalpha_o_obs = alpha_o;\nif isempty(alpha_o_obs)\n  if sensorless\n    alpha_o_obs = 2*pi*50;\n  else\n    alpha_o_obs = 2*pi*400;\n  end\n  if ~isempty(J)\n    alpha_o_obs = alpha_o_obs/sqrt(3);\n  end\nend\n% Default observer gain of create_speed_flux_observer, k_o(w_m) = k0 +\n% k1*abs(w_m) (k0 = NaN: sigma0 of the machine model, see the FluxObserver)\nk_o_obs = k_o;\nif isempty(k_o_obs)\n  if sensorless\n    k_o_obs = [NaN 0.2];\n  else\n    k_o_obs = [2*pi*15 0];\n  end\nend\n% Gains for critically damped dynamics (SpeedFluxObserver.__init__), the\n% pole matched to the sampling period (matched_pole)\nalpha_o_obs = -expm1(-alpha_o_obs*T_s)/T_s;\nif isempty(J)\n  k_theta = 2*alpha_o_obs;\n  k_w = alpha_o_obs^2;\n  k_tau = 0;\nelse\n  k_theta = 3*alpha_o_obs;\n  k_w = 3*alpha_o_obs^2;\n  k_tau = J*alpha_o_obs^3;\nend\n% Weight of the measured rotor angle in the FluxObserver (position_error)\nh = 1 - sensorless;\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "par"
        Prompt        "par: Machine model (SynchronousMachinePars, or SaturatedSynchronousMachinePars with a GradNet flux map psi_s_dq_fcn) as a struct"
        Type          FreeText
        Value         "par"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "alpha_o"
        Prompt        "alpha_o: Speed estimation poles (rad/s), [] = default"
        Type          FreeText
        Value         "cfg.alpha_o"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain [k0 k1], k_o(w_m) = k0 + k1*abs(w_m), [] = default"
        Type          FreeText
        Value         "cfg.k_o"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_f"
        Prompt        "k_f: PM-flux estimation gain, only [] (zero)"
        Type          FreeText
        Value         "cfg.k_f"
        Show          off
        Tunable       on
        TabName       ""
