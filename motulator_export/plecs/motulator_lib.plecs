      Parameter {
        Variable      "Parameters"
        Value         "psi_s_nom, i_s_max, tau_M_max, k_u, k_b, par_n_p, par_R_s, par_R_R, par_L_sgm, par_L_M"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
