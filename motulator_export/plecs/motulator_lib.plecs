      Parameter {
        Variable      "NumInputs"
        Value         "[1 2 1]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[1 1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
