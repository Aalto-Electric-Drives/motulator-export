        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../c/common.c\"\n#include \"../c/im_current_vector.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\nstatic PIController self;\nstatic double T_s; /* Sampling period */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(0) != 1) {\n    SetErrorMessage(\"J must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"alpha_s must be a scalar.\");\n    return;\n}\nif (PDIM(4) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\nT_s = P(4, 0);\nself = speed_controller(P(0, 0), P(1, 0), PARAM(2),\n                        PDIM(3) > 0 ? P(3, 0) : INFINITY);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "/* Torque reference, zero in standby */\nOutputSignal(0, 0) = (InputSignal(0, 0) != 0.0) ? 0.0\n    : pi_compute_output(&self, InputSignal(3, 0), InputSignal(1, 0), 0.0);\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "/* The limited torque reference ref.tau_M (anti-windup), not updated in\n * standby */\nif (InputSignal(0, 0) == 0.0) {\n    pi_update(&self, T_s, InputSignal(2, 0));\n}\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
