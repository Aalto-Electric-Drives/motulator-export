    Component {
      Type          CScript
      Name          "C-Script"
      Show          on
      Position      [155, 50]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -20; 50, 20]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[2 23]"
        Show          off
      }
      Parameter {
