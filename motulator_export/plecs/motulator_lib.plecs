    Component {
      Type          CScript
      Name          "compute_output"
      Show          on
      Position      [230, 100]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -25; 50, 25]
      Parameter {
        Variable      "DialogGeometry"
