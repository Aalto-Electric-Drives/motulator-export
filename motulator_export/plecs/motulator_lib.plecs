    Component {
      Type          Subsystem
      Name          "PWM"
      Show          on
      Position      [450, 215]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -50; 50, 50]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "PWM (motulator)"
      MaskDescription "Space-vector PWM with the minimum-phase-error (MPE) or the minimum-magnitude-error (MME) overmodulation (PWM), with the duty-ratio error model d_err = InverterNonlinearity(t_d, u_th, sign) and its compensation, the minimum pulses, and the single update. The blocks inside are its methods compute_output and get_realized_voltage. While the gates are blocked (the input enable is zero), the realized voltage is unknown (NaN), so the observers run on their open-circuit model, as in get_feedback of the control system."
      MaskInit      "% MME overmodulation, or MPE\nmme = strcmp(overmodulation, 'MME');\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "T_s"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "t_d"
        Prompt        "t_d: Dead time (s) in d_err = InverterNonlinearity(t_d, u_th, sign)"
        Type          FreeText
        Value         "pwm.t_d"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "u_th"
        Prompt        "u_th: Threshold voltage (V) in InverterNonlinearity (d_err = None if t_d = u_th = 0)"
        Type          FreeText
        Value         "pwm.u_th"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "i_0"
        Prompt        "i_0: Current scale (A) of sign = tanh(i/i_0) in InverterNonlinearity, 0 = np.sign"
        Type          FreeText
        Value         "pwm.i_0"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "feedforward"
        Prompt        "feedforward: Compensate for d_err (1) or not (0)"
        Type          FreeText
        Value         "pwm.feedforward"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "d_min"
        Prompt        "d_min: Minimum duty ratio of a switching leg, 0 = no limit"
        Type          FreeText
        Value         "pwm.d_min"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "single_update"
        Prompt        "single_update: Duty ratios updated once (1) or twice (0) per carrier period"
        Type          FreeText
        Value         "pwm.single_update"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "overmodulation"
        Prompt        "overmodulation: Overmodulation, 'MPE' or 'MME'"
        Type          FreeText
        Value         "pwm.overmodulation"
        Show          off
        Tunable       on
        TabName       ""
      }
