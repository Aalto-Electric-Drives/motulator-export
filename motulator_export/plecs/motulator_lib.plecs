    Component {
      Type          CScript
      Name          "get_measurement"
      Show          on
      Position      [230, 145]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -25; 50, 25]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
