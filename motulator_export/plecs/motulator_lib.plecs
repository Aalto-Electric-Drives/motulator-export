    Component {
      Type          CScript
      Name          "modulate"
      Show          on
      Position      [925, 85]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -20; 50, 20]
      Parameter {
        Variable      "DialogGeometry"
