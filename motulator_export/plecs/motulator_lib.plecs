    Component {
      Type          CScript
      Name          "standby"
      Show          on
      Position      [200, 45]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-30, -15; 30, 15]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[1]"
        Show          off
      }
      Parameter {
