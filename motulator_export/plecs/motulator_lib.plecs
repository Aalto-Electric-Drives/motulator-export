      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../c/common.c\"\n#include \"../c/gfm_observer.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(4, k);\n}\nGFMFeedbacks fbk;\ngfm_feedbacks_unpack(fbk_u, &fbk);\n/* References of compute_output, or while the gates are blocked, of\n * compute_standby_output */\nif (InputSignal(0, 0) > 0.0) {\n    OutputSignal(0, 0) = InputSignal(1, 0);\n    OutputSignal(1, 0) = InputSignal(2, 0);\n    OutputSignal(2, 0) = InputSignal(3, 0);\n    OutputSignal(2, 1) = InputSignal(3, 1);\n} else {\n    OutputSignal(0, 0) = fbk.p_g;\n    OutputSignal(1, 0) = cabs(fbk.v_c);\n    OutputSignal(2, 0) = creal(fbk.i_c);\n    OutputSignal(2, 1) = cimag(fbk.i_c);\n}\n"
