        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../c/common.c\"\n#include \"../c/gfm_observer.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\nstatic PowerReferenceLimiter self;\nstatic double T_s; /* Sampling period */\nstatic int limit; /* Limiter used (i_d_max given) */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(1) != 1) {\n    SetErrorMessage(\"alpha_l must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 1) {\n    SetErrorMessage(\"u_nom must be a scalar.\");\n    return;\n}\nif (PDIM(3) != 1) {\n    SetErrorMessage(\"T_s must be a scalar.\");\n    return;\n}\n/* No limiter without i_d_max */\nlimit = PDIM(0) > 0;\nif (limit) {\n    power_reference_limiter_init(&self, P(0, 0), P(1, 0), P(2, 0));\n}\nT_s = P(3, 0);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double p_g_ref = InputSignal(0, 0);\nif (limit) {\n    p_g_ref = power_reference_limiter_compute_output(&self, p_g_ref);\n}\nOutputSignal(0, 0) = p_g_ref;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "if (limit) {\n    power_reference_limiter_update(&self, T_s, complex_from(InputSignal(1, 0), InputSignal(1, 1)),\n                                   complex_from(InputSignal(2, 0), InputSignal(2, 1)), 0.0);\n}\n"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
