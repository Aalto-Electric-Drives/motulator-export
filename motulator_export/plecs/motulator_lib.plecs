    Component {
      Type          Subsystem
      Name          "FluxObserver"
      Show          on
      Position      [175, 60]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      SampleTime    "-1"
      CodeGenDiscretizationMethod "2"
      CodeGenTarget "Generic"
      MaskType      "FluxObserver (motulator)"
      MaskDescription "Reduced-order flux observer in synchronous coordinates (FluxObserver). The observer uses the voltage u_s_zoh_ab of the ongoing sampling period, and the output fbk.u_s is the voltage u_s_ab averaged over the previous and ongoing periods (DriveControlSystem.get_feedback). While the gates are blocked, the voltages are unknown (NaN), and the flux estimate follows the current model alone, with the open-circuit voltage of the model as the voltage. In the sensored mode (h = 1), the speed error signal is computed from the measured rotor speed (compute_feedback). The machine model par is a struct with the fields n_p, R_s, R_R, L_sgm, and L_M of InductionMachineInvGammaPars."
      MaskInit      "% Fields of the machine model par (InductionMachineInvGammaPars) for the\n% C-Script\npar_n_p = par.n_p;\npar_R_s = par.R_s;\npar_R_R = par.R_R;\npar_L_sgm = par.L_sgm;\npar_L_M = par.L_M;\n"
      MaskIconFrame on
      MaskIconOpaque off
      MaskIconRotates on
      Parameter {
        Variable      "par"
        Prompt        "par: Machine model (InductionMachineInvGammaPars) as a struct"
        Type          FreeText
        Value         "par"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain k_o(w_m), the default of create_speed_flux_observer in the sensorless (1) or sensored (0) mode"
        Type          FreeText
        Value         "k_o"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "h"
        Prompt        "h: Weight of the measured rotor speed, 0 = sensorless, 1 = sensored"
        Type          FreeText
        Value         "h"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "T_s"
        Prompt        "T_s: Sampling period (s)"
        Type          FreeText
        Value         "T_s"
        Show          off
        Tunable       on
        TabName       ""
      }
      Terminal {
        Type          Input
        Position      [-50, -15]
        Direction     left
      }
      Terminal {
        Type          Input
        Position      [-50, -5]
        Direction     left
      }
      Terminal {
        Type          Input
        Position      [-50, 5]
