        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "if (PDIM(0) != 1) {\n    SetErrorMessage(\"R_a must be a scalar.\");\n    return;\n}\nif (PDIM(1) != 1) {\n    SetErrorMessage(\"k_v must be a scalar.\");\n    return;\n}\nif (PDIM(2) != 1) {\n    SetErrorMessage(\"k_c must be a scalar.\");\n    return;\n}\nself.R_a = P(0, 0);\nself.k_v = P(1, 0);\nself.k_c = P(2, 0);\n"
        Show          off
