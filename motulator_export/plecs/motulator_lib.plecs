    Component {
      Type          CScript
      Name          "modulate"
      Show          on
      Position      [935, 95]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -20; 50, 20]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[14 2]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[2 1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[1 1]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../c/common.c\"\n#include \"../c/gfm_observer.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\nstatic double T_s; /* Sampling period */\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         "T_s = P(0, 0);\n"
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(0, k);\n}\nGFMFeedbacks fbk;\ngfm_feedbacks_unpack(fbk_u, &fbk);\n/* Voltage reference in stationary coordinates, its angle advanced by\n * k_comp*T_s*w_c (k_comp = 1.5 of the controller) */\ndouble complex u_c_ref_ab = cexp(I * fbk.theta_c) * complex_from(InputSignal(1, 0), InputSignal(1, 1));\nu_c_ref_ab *= cexp(I * 1.5 * T_s * fbk.w_c);\nOutputSignal(0, 0) = creal(u_c_ref_ab);\nOutputSignal(0, 1) = cimag(u_c_ref_ab);\nOutputSignal(1, 0) = fbk.w_c;\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
    Component {
      Type          CScript
      Name          "Monitored signals"
      Show          on
      Position      [935, 225]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-50, -30; 50, 30]
      Parameter {
        Variable      "DialogGeometry"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "NumInputs"
        Value         "[14 6]"
        Show          off
      }
      Parameter {
        Variable      "NumOutputs"
        Value         "[3 2 4 1]"
        Show          off
      }
      Parameter {
        Variable      "NumContStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumDiscStates"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "NumZCSignals"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "[1 1]"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "T_s"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "/* Generated by motulator_export: a block of the control system. The\n * parameters come from its mask. */\n#include \"../c/common.c\"\n#include \"../c/gfm_observer.c\"\n\n#define P(i, j) ParamRealData(i, j)\n#define PDIM(i) (ParamDim(i, 0) * ParamDim(i, 1))\n\n/* Parameter value, or NAN for an empty parameter (None in motulator) */\n#define PARAM(i) (PDIM(i) > 0 ? P(i, 0) : NAN)\n\n"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "double fbk_u[FBK_WIDTH];\nfor (int k = 0; k < FBK_WIDTH; k++) {\n    fbk_u[k] = InputSignal(0, k);\n}\nGFMFeedbacks fbk;\ngfm_feedbacks_unpack(fbk_u, &fbk);\ndouble ref_u[REF_WIDTH];\nfor (int k = 0; k < REF_WIDTH; k++) {\n    ref_u[k] = InputSignal(1, k);\n}\nGFMReferences ref;\ngfm_references_unpack(ref_u, &ref);\n/* Monitored signals */\n/* The currents and the angle in the coordinates of v_c */\ndouble complex rot = cexp(-I * carg(fbk.v_c));\nOutputSignal(0, 0) = ref.p_g;\nOutputSignal(0, 1) = fbk.p_g;\nOutputSignal(0, 2) = fbk.q_g;\nOutputSignal(1, 0) = ref.v_c;\nOutputSignal(1, 1) = cabs(fbk.v_c);\nOutputSignal(2, 0) = creal(rot * ref.i_c);\nOutputSignal(2, 1) = creal(rot * fbk.i_c);\nOutputSignal(2, 2) = cimag(rot * ref.i_c);\nOutputSignal(2, 3) = cimag(rot * fbk.i_c);\nOutputSignal(3, 0) = wrap(fbk.theta_c + carg(fbk.v_c));\n"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
    }
