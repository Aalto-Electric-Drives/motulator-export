        Prompt        "k_theta: Rotor angle estimation gain (rad/s)"
        Type          FreeText
        Value         "k_theta"
        Show          off
        Tunable       on
        TabName       ""
      }
      Parameter {
        Variable      "k_o"
        Prompt        "k_o: Observer gain [k0 k1], k_o(w_m) = k0 + k1*abs(w_m), k0 = NaN: sigma0 of the machine model"
        Type          FreeText
